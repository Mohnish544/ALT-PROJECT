# ============================================================
# MedLens — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider: groq | ollama | openai | anthropic | mock ---
LLM_PROVIDER=groq

# Groq (100% Free, Ultra-Fast Cloud Inference — https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Embedding Model ---
# Biomedical sentence-transformer (downloads ~400MB on first run)
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
# Lightweight fallback: all-MiniLM-L6-v2
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K=5
DOC_FALLBACK_THRESHOLD=0.35   # If best doc score < this, fall back to KB

# --- Storage ---
UPLOAD_DIR=data/uploads
FAISS_INDEX_DIR=data/indexes
KB_INDEX_PATH=data/kb_index/medquad.faiss
KB_METADATA_PATH=data/kb_index/medquad_meta.pkl

# --- CORS (comma-separated origins for production) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
